---
/**
 * marketing_cta — a call-to-action banner in the slider's idiom: a
 * full-bleed photo under a teal-to-dark scrim, or the footer's dark
 * #1E3231 when there is no photo, with a white Playfair headline and
 * the slider's button pair (gold primary, white outline secondary).
 */
import type { Button } from "../../utils/marketing-blocks";

interface Props {
	title: string;
	paragraphs?: string[];
	image?: string;
	imageAlt?: string;
	buttons?: Button[];
	anchorId?: string;
}

const { title, paragraphs = [], image, imageAlt = "", buttons = [], anchorId } = Astro.props;
---

<section class:list={["lp-cta", "full-bleed", { "has-image": !!image }]} id={anchorId}>
	{image && <img class="lp-cta-image" src={image} alt={imageAlt} loading="lazy" />}
	<div class="lp-cta-inside aos aos-up">
		<h2 class="lp-cta-title">{title}</h2>
		{paragraphs.map((p) => <p class="lp-cta-text">{p}</p>)}
		{
			buttons.length > 0 && (
				<div class="lp-cta-buttons">
					{buttons.map((b) => (
						<a class={b.style === "primary" ? "btn-gold" : "btn-outline-white"} href={b.url}>
							{b.label}
						</a>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.lp-cta {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background-color: var(--color-footer-bg);
		color: #ffffff;
	}

	/* No photo: a gold strip along the top edge keeps the band from
	   reading as the footer arriving early. */
	.lp-cta:not(.has-image)::before {
		content: "";
		position: absolute;
		inset: 0 0 auto;
		height: 6px;
		background: var(--color-gold);
	}

	.lp-cta-image {
		position: absolute;
		z-index: -2;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.has-image::after {
		content: "";
		position: absolute;
		z-index: -1;
		inset: 0;
		background: linear-gradient(
			100deg,
			rgba(15, 139, 141, 0.88) 0%,
			rgba(30, 50, 49, 0.78) 65%,
			rgba(30, 50, 49, 0.6) 100%
		);
	}

	.lp-cta-inside {
		max-width: 820px;
		margin: 0 auto;
		padding: 7em 2em;
		text-align: center;
	}

	.lp-cta-title {
		margin: 0 0 0.5em;
		font-family: var(--font-heading);
		/* The text bands' title size, easing down on narrow screens */
		font-size: clamp(1.8em, 4vw, 2.617924em);
		line-height: 1.25;
		font-weight: var(--font-weight-heading);
		color: #ffffff;
	}

	/* The slider caption's subtitle: light, slightly tracked */
	.lp-cta-text {
		margin: 0 auto 1em;
		max-width: 640px;
		font-size: 1.2em;
		line-height: 1.5;
		font-weight: 300;
		letter-spacing: 1px;
	}

	.lp-cta-buttons {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1em;
		margin-top: 2em;
	}

	@media (max-width: 640px) {
		.lp-cta-inside {
			padding: 4em 1.25em;
		}
	}
</style>
