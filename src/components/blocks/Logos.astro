---
/**
 * marketing_logos — a quiet row of client or partner marks. Logos sit in
 * greyscale and come up to full colour on hover; a mark without an image
 * is set as a Playfair wordmark so the row still reads.
 */
import { tintStyle } from "../../utils/tint";

interface Logo {
	name: string;
	logo?: string;
	logoAlt?: string;
	url?: string;
}

interface Props {
	title?: string;
	items?: Logo[];
	tint?: string;
	anchorId?: string;
}

const { title, items = [], tint, anchorId } = Astro.props;
---

<section class="lp-logos full-bleed" style={tintStyle(tint)} id={anchorId}>
	<div class="lp-logos-inside">
		{
			title && (
				<h2 class="lp-logos-title">
					<span class="hl-gold">{title}</span>
				</h2>
			)
		}
		<ul class="lp-logos-row" role="list">
			{
				items.map((l) => {
					const mark = l.logo ? (
						<img src={l.logo} alt={l.logoAlt ?? l.name} loading="lazy" />
					) : (
						<span class="lp-logo-word">{l.name}</span>
					);
					return (
						<li class="lp-logo aos aos-fade">
							{l.url ? <a href={l.url}>{mark}</a> : mark}
						</li>
					);
				})
			}
		</ul>
	</div>
</section>

<style>
	.lp-logos {
		background-color: var(--color-surface);
		border-block: 1px solid var(--color-border-subtle);
	}

	.lp-logos-inside {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 4em 2.5em;
		text-align: center;
	}

	.lp-logos-title {
		margin: 0 0 2em;
		line-height: 1.3;
		font-family: var(--font-heading);
		font-size: 1.3em;
		font-weight: var(--font-weight-heading);
		color: var(--color-heading);
	}

	.lp-logos-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 2.5em 4em;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* No inherited 1.8 leading, so the row sits evenly in the band */
	.lp-logo {
		line-height: 1;
	}

	.lp-logo a {
		display: block;
		text-decoration: none;
	}

	.lp-logo img {
		display: block;
		max-height: 44px;
		max-width: 160px;
		width: auto;
		filter: grayscale(1);
		opacity: 0.65;
		transition:
			filter 0.3s ease-out,
			opacity 0.3s ease-out;
	}

	.lp-logo:hover img {
		filter: none;
		opacity: 1;
	}

	.lp-logo-word {
		font-family: var(--font-heading);
		font-size: 1.45em;
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--tracking-snug);
		color: var(--color-muted);
		transition: color 0.3s ease-out;
	}

	.lp-logo:hover .lp-logo-word {
		color: var(--color-teal);
	}

	@media (max-width: 640px) {
		.lp-logos-inside {
			padding: 2.5em 1em;
		}

		.lp-logos-row {
			gap: 1.5em 2.5em;
		}
	}
</style>
