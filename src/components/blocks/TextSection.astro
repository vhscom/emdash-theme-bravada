---
/**
 * marketing_text — ordinary prose between bands: a centred article-width
 * column with a Playfair headline under the gold highlighter, and the
 * block's rich text rendered with the theme's own Portable Text types.
 */
import type { PortableTextBlock } from "emdash";
import RichText from "../RichText.astro";

interface Props {
	title?: string;
	body?: PortableTextBlock[];
	anchorId?: string;
}

const { title, body, anchorId } = Astro.props;
---

<section class="lp-plain-text full-bleed" id={anchorId}>
	<div class="lp-plain-text-inside">
		{
			title && (
				<h2 class="lp-plain-text-title">
					<span class="hl-gold">{title}</span>
				</h2>
			)
		}
		{
			body && body.length > 0 && (
				<div class="lp-plain-text-body">
					<RichText value={body} />
				</div>
			)
		}
	</div>
</section>

<style>
	.lp-plain-text {
		background-color: var(--color-bg);
	}

	.lp-plain-text-inside {
		max-width: var(--content-width);
		margin: 0 auto;
		/* The text bands' 7em top and bottom, at their 16px body size */
		padding: 7em 1.5em;
		line-height: 1.8;
		color: var(--color-text);
	}

	/* Same scale as the text bands' .lp-text-title */
	.lp-plain-text-title {
		margin: 0 0 0.6em;
		font-family: var(--font-heading);
		font-size: 2.617924em;
		line-height: 1.3;
		font-weight: var(--font-weight-heading);
		color: var(--color-heading);
	}

	.lp-plain-text-body :global(p) {
		margin: 0 0 1.2em;
	}

	.lp-plain-text-body :global(p:last-child) {
		margin-bottom: 0;
	}

	@media (max-width: 640px) {
		.lp-plain-text-inside {
			padding: 4em 1em;
		}

		.lp-plain-text-title {
			font-size: 1.5em;
		}
	}

	/* Scoped to the body, so the band's own title keeps its margins */
	.lp-plain-text-body :global(:is(h2, h3, h4)) {
		margin: 1.6em 0 0.6em;
		font-family: var(--font-heading);
		line-height: 1.3;
		color: var(--color-heading);
	}

	.lp-plain-text-body :global(a) {
		color: var(--color-brand);
	}

	.lp-plain-text-body :global(a:hover) {
		color: var(--color-brand-hover);
	}
</style>
