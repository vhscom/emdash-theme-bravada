---
import { getEmDashCollection, getSiteSettings, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import ArchiveLayout from "../../layouts/ArchiveLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getReadingTime } from "../../utils/reading-time";
import { resolveSiteOrigin } from "../../utils/site-identity";

// Theme pagination: 10 posts per page with numeric page links, matching
// the search page. EmDash exposes offset paging and `hasMore` but no
// collection count, and the demo's pager needs a total to number the
// links — so fetch one capped batch (200, beyond any plausible demo
// corpus) and window it, the same trade the search page makes.
const PER_PAGE = 10;
const MAX_POSTS = 200;

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const { entries: allPosts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: MAX_POSTS,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const totalPages = Math.max(1, Math.ceil(allPosts.length / PER_PAGE));
const page = Math.min(
	totalPages,
	Math.max(1, Number.parseInt(Astro.url.searchParams.get("page") ?? "1") || 1),
);
const posts = allPosts.slice((page - 1) * PER_PAGE, page * PER_PAGE);

const pageUrl = (n: number) => (n > 1 ? `/posts?page=${n}` : "/posts");

// Batched category + tag lookups for the current page only (avoids N+1
// queries); bylines are already hydrated on entry.data.bylines.
const entryIds = posts.map((p) => p.data.id);
const [catsByEntry, tagsByEntry] = await Promise.all([
	getTermsForEntries("posts", entryIds, "category"),
	getTermsForEntries("posts", entryIds, "tag"),
]);

const cards = posts.map((post) => ({
	post,
	categories: (catsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
	bylines: post.data.bylines ?? [],
}));

// Each page of the archive is its own URL, so it canonicalises to
// itself. Pointing pages 2..n back at /posts (what the default
// canonical did) tells search engines the deeper pages are duplicates
// of page one — the opposite of what a pager means, and Google's
// guidance is explicit that paginated pages should not be
// canonicalised to the first. The "Page N" part mirrors what
// WordPress adds to a paginated document title; the en dash joining
// it is ours, core joins its title parts with a plain hyphen
// (document_title_separator, which Bravada does not filter). Base
// still appends the site title with the separator from settings.
const siteOrigin = resolveSiteOrigin(await getSiteSettings(), Astro.url.origin);
const canonical = `${siteOrigin}${pageUrl(page)}`;
const title = page > 1 ? `Blog – Page ${page}` : "Blog";
---

<Base
	title={title}
	description="Browse all blog posts"
	canonical={canonical}
	overHero
>
	<PageHeader
		title="Blog"
		subtitle={`${allPosts.length} ${allPosts.length === 1 ? "article" : "articles"}`}
		crumbs={[{ label: "Blog" }]}
	/>

	<ArchiveLayout>
		{
			posts.length === 0 ? (
				<p class="empty">No posts yet.</p>
			) : (
				<div class="archive-grid">
					{cards.map(({ post, categories, tags, bylines }) => (
						<PostCard
							title={post.data.title ?? "Untitled"}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							categories={categories}
							tags={tags}
							bylines={bylines}
						/>
					))}
				</div>
			)
		}

		<Pagination
			page={page}
			totalPages={totalPages}
			pageUrl={pageUrl}
			label="Blog pages"
		/>
	</ArchiveLayout>
</Base>

<style>

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

</style>
